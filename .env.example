APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=tesis-iot
REVERB_APP_KEY=tesis-iot-key
REVERB_APP_SECRET=tesis-iot-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MQTT_HOST=10.150.253.2
MQTT_PORT=1883
MQTT_CLIENT_ID=laravel-mqtt-subscriber
MQTT_USERNAME=mqtt-uleam
MQTT_PASSWORD=Mqtt-Uleam2025$
MQTT_KEEP_ALIVE=60
MQTT_QOS=1
MQTT_TOPICS=iot_uleam/uleam

# Opcional: escuchar multiples brokers a la vez usando JSON en una sola linea.
# Si se define MQTT_CONNECTIONS, tiene prioridad sobre MQTT_HOST/MQTT_TOPICS.
# MQTT_CONNECTIONS=[{"name":"rak-chirpstack","host":"172.29.101.43","port":1883,"username":null,"password":null,"qos":0,"topics":["application/+/device/+/event/up"]},{"name":"uleam-water","host":"10.150.253.2","port":1883,"username":"mqtt-uleam","password":"Mqtt-Uleam2025$","qos":1,"topics":["iot_uleam/uleam"]}]
